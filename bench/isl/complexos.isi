// Isiliel — scripting language interpreter/compiler.
// Embedded: sandbox, embedding API, OOP, 2D graphics, and REPL.
// Authors: Eben (AI-assisted) | Version: 1.0 | Date: 2026-11-08
// Complex numbers: Mandelbrot (z = z^2 + c) with the native complex type (j suffix).
fn bench() {
    total = 0;
    width = 200;
    height = 200;
    maxit = 50;
    z0 = rect(0.0, 0.0);
    for (py = 0; py < height; py = py + 1) {
        ci = (py / height) * 2.0 - 1.0;
        for (px = 0; px < width; px = px + 1) {
            cr = (px / width) * 2.5 - 2.0;
            z = z0;
            c = rect(cr, ci);
            it = 0;
            while (it < maxit && abs(z) <= 2.0) {
                z = z * z + c;
                it = it + 1;
            }
            total = total + it;
        }
    }
    return total;
}
printf("%d\n", bench());
