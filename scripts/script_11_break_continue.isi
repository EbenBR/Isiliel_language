// Teste de break/continue em while e for
teste_while() {
    i = 0;
    soma = 0;
    while (i < 10) {
        i = i + 1;
        if (i == 3) {
            continue;
        }
        if (i == 6) {
            break;
        }
        soma = soma + i;
    }
    println(soma); // 1+2+4+5 = 12
}

teste_for() {
    total = 0;
    for (i = 1; i <= 10; i = i + 1) {
        if (i > 4) {
            break;
        }
        if (i == 2) {
            continue;
        }
        total = total + i;
    }
    println(total); // 1+3+4 = 8
}

teste_for_sem_cond() {
    n = 0;
    for (k = 0; ; k = k + 1) {
        if (k == 5) {
            break;
        }
        if (k % 2 == 0) {
            continue;
        }
        n = n + k; // 1+3 = 4
    }
    println(n);
}

teste_aninhado() {
    achou = 0;
    for (i = 1; i <= 3; i = i + 1) {
        for (j = 1; j <= 3; j = j + 1) {
            if (j == 2) {
                break; // quebra só o loop interno
            }
            achou = achou + 1;
        }
    }
    println(achou); // 3 * 1 = 3
}

teste_while();
teste_for();
teste_for_sem_cond();
teste_aninhado();
