teste1() {
    // Teste de operacao bitwise e atribuicao composta
    x = 5;      // 0101 em binario
    x = x << 1; // 1010 (10 em decimal)
    x += 2;     // 12 em decimal
    println("Resultado Bitwise + Composta (esperado 12):");
    println(x);

    // Teste de biblioteca matematica
    val = pow(2, 3) + sin(0);
    println("Resultado Math (pow(2,3) + sin(0)):");
    println(val);
}

teste2() {
    // Definicao da Matriz A
    A = [[1, 2], [3, 4]];
    println("Matriz A:");
    println(A);

    B = [[5, 6], [7, 8]];
    println("Matriz B:");
    println(B);
    
    C = A * B;
    println("Matriz C:");
    println(C);
}

println("Chamando a funcao teste1()");
teste1();

println("Chamando a funcao teste2()");
teste2();
