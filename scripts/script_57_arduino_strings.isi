// script_57 - Arduino String: funcoes livres sobre texto imutavel.
s = "  Hello Arduino  ";
assert(trim(s) == "Hello Arduino");
assert(upper("aBc") == "ABC");
assert(lower("aBc") == "abc");
assert(length("abc") == 3);
assert(charAt("abc", 1) == "b");
assert(charAt("abc", 9) == "");
assert(compareTo("abc", "abd") < 0);
assert(c_str("abc") == "abc");
assert(endsWith("abc.txt", ".txt") == 1);
assert(equals("a", "a") == 1);
assert(equalsIgnoreCase("AbC", "aBc") == 1);
assert(indexOf("banana", "na") == 2);
assert(indexOf("banana", "na", 3) == 4);
assert(lastIndexOf("banana", "na") == 4);
assert(remove("banana", 1, 3) == "bna");
assert(remove("banana", 3) == "ban");
assert(replace("banana", "na", "NA") == "baNANA");
assert(reserve("abc", 20) == "abc");
assert(setCharAt("abc", 1, "X") == "aXc");
assert(startsWith("abc", "ab") == 1);
assert(substring("abcdef", 1, 4) == "bcd");
assert(substring("abcdef", 4, 1) == "bcd");
assert(toDouble("  -12.5xyz") == -12.5);
assert(toFloat("3.25") == 3.25);
assert(toInt(" 42abc") == 42);
assert(toLowerCase("AbC") == "abc");
assert(toUpperCase("AbC") == "ABC");
assert(concat("a", 1) == "a1");
assert(String() == "");
assert(String(123) == "123");
assert(String(1.0) == "1.00");
assert(String(1.25) == "1.25");
assert(String(255, 16) == "ff");
assert(String(3.14159, 2) == "3.14");

b = getBytes("Az");
assert(b[0] == 65);
assert(b[1] == 122);
c = toCharArray("Az");
assert(c[0] == 65);
assert(c[1] == 122);

buf = [0, 0, 0, 0];
n = getBytes("Az", buf, 2);
assert(n == 2);
assert(buf[0] == 65);
assert(buf[1] == 122);
buf2 = [0, 0, 0];
n = toCharArray("Az", buf2);
assert(n == 2);
assert(buf2[0] == 65);
assert(buf2[1] == 122);

println(trim(s));
println(indexOf("banana", "na", 3));
println(substring("abcdef", 4, 1));
println(String(255, 16));
println(String(3.14159, 2));
println("arduino strings ok");
