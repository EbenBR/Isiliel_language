// Isiliel — regressao: `for` dentro de argumento/expressao aninhada.
// Bug E9: OP_POP duplo no init/incr do for comia o stack do chamador.
// Autores: EEPS e MiMo-V2.6 | Versao: 1.0 | Data: 2026-11-08
fn com_for() {
    s = 0;
    for (i = 1; i <= 10; i = i + 1) { s = s + (i % 3); }
    return s;
}
fn com_while() {
    s = 0;
    while (s < 10) { s = s + 1; }
    return s;
}
printf("%d\n", com_for());
printf("%s=%d\n", "soma", com_for());
printf("%d|%d\n", com_for(), com_while());
println(100 + com_for());
