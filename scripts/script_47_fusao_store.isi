// Regressao E19: fusao `x = x OP expr` so quando o LOAD de x e o operando
// esquerdo do OP final (antes, `x = x * y + z` gerava ADD_STORE invalido).
a = 2;
b = 3;
s = 1;  s = s * a + b;      println(s);  // 5
s = 1;  s = s + a + b;      println(s);  // 6
s = 2;  s = s + a * b;      println(s);  // 8
s = 5;  s = s - a - b;      println(s);  // 0
s = 10; s = s + (a + b) * 2; println(s); // 20
s = 1;  s = s + 1;          println(s);  // 2
s = 1;  s += a;             println(s);  // 3
z = 1 + 2j;
c = 3 + 4j;
z = z * z + c;              println(z);  // 8j
