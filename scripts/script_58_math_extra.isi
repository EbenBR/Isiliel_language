// script_58 - math.h: funcoes C99 e constantes resolvidas no compilador.
assert(abs(acos(1)) < 0.000000000001);
assert(abs(asin(0)) < 0.000000000001);
assert(abs(atan(1) - PI / 4) < 0.000000000001);
assert(abs(cosh(0) - 1) < 0.000000000001);
assert(abs(sinh(0)) < 0.000000000001);
assert(abs(tanh(0)) < 0.000000000001);
assert(abs(acosh(1)) < 0.000000000001);
assert(abs(asinh(0)) < 0.000000000001);
assert(abs(atanh(0)) < 0.000000000001);
assert(exp2(3) == 8);
assert(abs(expm1(0)) < 0.000000000001);
assert(log2(8) == 3);
assert(abs(log1p(0)) < 0.000000000001);
assert(abs(cbrt(27) - 3) < 0.000000000001);
assert(abs(erf(0)) < 0.000000000001);
assert(abs(erfc(0) - 1) < 0.000000000001);
assert(abs(tgamma(5) - 24) < 0.000000000001);
assert(abs(lgamma(5) - 3.1780538303479458) < 0.000000001);
assert(trunc(3.7) == 3);
assert(rint(3.7) == 4);
assert(nearbyint(3.7) == 4);
assert(fabs(-3.5) == 3.5);
assert(hypot(3, 4) == 5);
assert(fdim(5, 3) == 2);
assert(fmax(2, 3) == 3);
assert(fmin(2, 3) == 2);
assert(copysign(2, -1) == -2);
assert(nextafter(1, 2) > 1);
assert(remainder(7, 3) == 1);
assert(lround(2.6) == 3);
assert(llround(2.6) == 3);
assert(lrint(2.6) == 3);
assert(llrint(2.6) == 3);
assert(ilogb(8) == 3);
assert(logb(8) == 3);
assert(ldexp(1, 3) == 8);
assert(scalbn(1, 3) == 8);
assert(scalbln(1, 3) == 8);
assert(fma(2, 3, 4) == 10);

a, b = frexp(8);
assert(a == 0.5);
assert(b == 4);
f, i = modf(3.5);
assert(f == 0.5);
assert(i == 3);
r, q = remquo(7, 3);
assert(r == 1);
assert(q == 2);

assert(isfinite(1) == 1);
assert(isinf(INFINITY) == 1);
assert(isnan(NAN) == 1);
assert(isnormal(1) == 1);
assert(signbit(-1) == 1);
assert(isgreater(2, 1) == 1);
assert(isgreaterequal(2, 2) == 1);
assert(isless(1, 2) == 1);
assert(islessequal(2, 2) == 1);
assert(islessgreater(2, 1) == 1);
assert(isunordered(NAN, 1) == 1);
assert(fpclassify(NAN) == FP_NAN);
assert(fpclassify(INFINITY) == FP_INFINITE);
assert(fpclassify(0) == FP_ZERO);
assert(fpclassify(1) == FP_NORMAL);

assert(abs(PI - 3.141592653589793) < 0.000000000001);
assert(abs(E - 2.718281828459045) < 0.000000000001);
assert(abs(TAU - 2 * PI) < 0.000000000001);
assert(abs(PI_2 - PI / 2) < 0.000000000001);
assert(abs(SQRT2 - 1.4142135623730951) < 0.000000000001);
assert(abs(LN2 - 0.6931471805599453) < 0.000000000001);
assert(abs(PHI - 1.618033988749895) < 0.000000000001);
assert(abs(DEG_TO_RAD - PI / 180) < 0.000000000001);
assert(abs(M_PI - PI) < 0.000000000001);
assert(MATH_ERRNO == 1);
assert(MATH_ERREXCEPT == 2);
assert(math_errhandling == 3);

println(acos(1));
println(exp2(3));
println(hypot(3, 4));
println(tgamma(5));
println(frexp(8));
println(PI);
println(String(TAU, 5));
println("math extra ok");
